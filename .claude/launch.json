{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/bin:$PATH; exec node ./node_modules/.bin/next dev --turbopack"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-webpack",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=/opt/homebrew/bin:$PATH; exec node ./node_modules/.bin/next dev --webpack"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}
